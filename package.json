{
  "name": "openbridge",
  "private": true,
  "version": "1.2.0",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:library": "vite build --config vite.library.config.ts",
    "build:package": "tsc -b && vite build --base=./",
    "package:openbridge": "pnpm build:package && pnpm build:library && node scripts/package-openbridge.mjs",
    "build:ftp": "tsc -b && vite build --base=/openbridge/",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "validate:phase2": "node scripts/validate-phase2.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
